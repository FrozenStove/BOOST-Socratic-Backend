# Development Dockerfile - for hot reload
FROM node:22-slim

WORKDIR /app

# Install dependencies for development
RUN apt-get update && apt-get install -y curl wget openssl && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm i

# Copy source code (will be overridden by volume mount in dev)
COPY . .

# Generate Prisma Client
RUN npm run db:generate

# Expose the port
EXPOSE 3010

# Use dev command for hot reload
CMD ["npm", "run", "dev"]

