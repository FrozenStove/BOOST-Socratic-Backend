# OpenAI (still used for GPT-4 chat completions)
OPENAI_API_KEY=

# Google Cloud / Firebase
GOOGLE_CLOUD_PROJECT=ucsf-medical-education-app
GOOGLE_CLOUD_LOCATION=us-central1

# Path to your Firebase Admin service account JSON (local dev only)
# On Cloud Run this is NOT needed — ADC is used automatically
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Set to "true" to bypass authentication for local development
DISABLE_AUTH=false
